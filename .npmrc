# Project-wide npm policy. The frontend/ module has an identical .npmrc for
# when npm runs from within that directory (Docker build, IDE, etc.).
#
# SystemForge does NOT commit lock files (see frontend/AGENTS.md):
# dependencies are pinned exactly via save-exact in package.json instead.
# Keeping package-lock=false at repo root prevents IDEs / Maven / CI / scripts
# that invoke `npm install` from the repo root (or anywhere outside frontend/)
# from generating a stray package-lock.json across dev environments.
engine-strict=true
save-exact=true
package-lock=false
