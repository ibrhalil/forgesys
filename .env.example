# ============================================================
# Database
# ============================================================
POSTGRES_DB=forgesys
POSTGRES_USER=forgeadmin
POSTGRES_PASSWORD=change-me-in-production

# ============================================================
# Spring Boot
# ============================================================
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/forgesys?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=forgeadmin
SPRING_DATASOURCE_PASSWORD=change-me-in-production

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Optional externalized config overlay (mounted at /config in the app container).
# Leave as-is for default; drop application-prod.yaml into infra/config/ to override.
SPRING_CONFIG_ADDITIONAL_LOCATION=optional:file:/config/

# Spring Boot file-appender destination (mounted at /app/logs).
# Defaults are baked into the compose file; only override if needed.
LOGGING_FILE_PATH=/app/logs

# ============================================================
# Security — password pepper (K-23)
# ============================================================
# Global secret combined with BCrypt (HMAC pre-hash) so a DB leak alone cannot
# brute-force password hashes. Generate 32+ random chars (e.g. `openssl rand -base64 32`).
# MUST be set in prod — a blank value fails startup. Never commit/log the real value.
PASSWORD_PEPPER=change-me-to-a-long-random-string

# ============================================================
# Mail — outgoing SMTP (K-53)
# ============================================================
# Provider-agnostic: managed (Brevo/SendGrid/SES SMTP) or your own relay
# (setup guide: docs/MAIL_RUNBOOK.md). Empty MAIL_HOST => the app fails
# startup fast on purpose (no silent mail loss in prod).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# RFC 822 form ("Name <addr>") — should match the sending domain verified in
# SPF/DKIM (runbook) for deliverability.
MAIL_FROM=ForgeSys <no-reply@mg.example.com>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ============================================================
# Mail — app-as-subdomain config (K-53 test deployment)
# ============================================================
# App served under an existing domain's subdomain, e.g. app.example.com with
# tenants at <tenant>.app.example.com. APP_BASE_URL builds the mailed action
# links; BASE_DOMAIN drives TenantFilter subdomain resolution. Requires
# wildcard DNS (+ wildcard TLS — roadmap K-33 Nginx gateway).
# BASE_DOMAIN=app.example.com
# APP_BASE_URL=https://app.example.com
