# ============================================================
# Database
# ============================================================
POSTGRES_DB=forgesys
POSTGRES_USER=forgeadmin
POSTGRES_PASSWORD=change-me-in-production

# ============================================================
# Spring Boot
# ============================================================
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/forgesys?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=forgeadmin
SPRING_DATASOURCE_PASSWORD=change-me-in-production

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Optional externalized config overlay (mounted at /config in the app container).
# Leave as-is for default; drop application-prod.yaml into infra/config/ to override.
SPRING_CONFIG_ADDITIONAL_LOCATION=optional:file:/config/

# Spring Boot file-appender destination (mounted at /app/logs).
# Defaults are baked into the compose file; only override if needed.
LOGGING_FILE_PATH=/app/logs

# ============================================================
# Security — password pepper (K-23)
# ============================================================
# Global secret combined with BCrypt (HMAC pre-hash) so a DB leak alone cannot
# brute-force password hashes. Generate 32+ random chars (e.g. `openssl rand -base64 32`).
# MUST be set in prod — a blank value fails startup. Never commit/log the real value.
PASSWORD_PEPPER=change-me-to-a-long-random-string
