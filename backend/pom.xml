<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ibrhalil</groupId>
        <artifactId>forgesys</artifactId>
        <version>0.2.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>forgesys-backend</artifactId>
    <name>forgesys-backend</name>
    <description>Backend module for ForgeSys SaaS platform</description>

    <dependencies>
        <dependency>
            <groupId>com.ibrhalil</groupId>
            <artifactId>forgesys-common</artifactId>
        </dependency>

        <dependency>
            <groupId>com.ibrhalil</groupId>
            <artifactId>forgesys-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Prometheus metrics registry (K-43 / Faz 5 observability): exposes
             /actuator/prometheus in the text exposition format. Version comes from
             the spring-boot-dependencies BOM — no pin. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- SMTP mail (user lifecycle + mail epic). Version from the BOM; consumed by
             SmtpMailSender (prod profile only). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- OpenAPI 3 docs + Swagger UI (K-41). Dev-only: application-prod.yaml sets
             springdoc.api-docs.enabled/swagger-ui.enabled=false. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers — real PostgreSQL cross-tenant isolation tests ([RISK-20]).
             Versions are managed by the spring-boot-dependencies BOM (no pin here).
             The integration test is gated by -Dforgesys.pg.it=true so the default
             Docker-free build (mvn clean install) stays green. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>forgesys-backend</finalName>
        <plugins>
            <!-- Pin the test JVM to the English locale: H2's LOWER() follows the JVM
                 default locale, and on a Turkish-locale machine lower('I')='ı' breaks
                 the Locale.ROOT-folded case-insensitive search (FilterSpecifications).
                 Deterministic on any dev machine; matches CI and the en-locale PG. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Duser.language=en -Duser.country=US</argLine>
                </configuration>
            </plugin>
            <!-- K-51: mail templates' single git source is infra/templates/mail;
                 inject it into the jar's classpath so the renderer fallback and
                 tests keep working without a second tracked copy. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-mail-templates</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/mail</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../infra/templates/mail</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Anchor spring-boot:run at the repo root: the plugin defaults the
                         working directory to the module dir (backend/), which breaks the
                         project-relative logging.file.path=infra/logs and creates a stray
                         backend/infra/logs. Matches the shared IDE run config
                         ($ProjectFileDir$) so both launchers resolve infra/ identically. -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
