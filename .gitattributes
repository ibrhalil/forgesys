# ============================================================
# Cross-platform line ending policy.
#
# Default: text + LF (deterministic across Windows/macOS/Linux).
# Container-side scripts (mvnw, *.sh, Dockerfile, SQL) MUST stay LF
# otherwise Docker/Linux execution breaks and Flyway checksums drift.
#
# Windows-only batch scripts stay CRLF (cmd.exe parses them that way).
# ============================================================

# Default: auto-normalize, LF on checkout (works everywhere)
* text=auto eol=lf

# Windows-only scripts: CRLF mandatory
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts (Linux container runtime): LF
*.sh text eol=lf
mvnw text eol=lf

# Dockerfile family: LF
Dockerfile* text eol=lf
*.dockerfile text eol=lf

# Config files: LF
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml  text eol=lf
*.properties text eol=lf
.env        text eol=lf
.env.*      text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Source code: LF
*.java text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.kt   text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg  text eol=lf

# SQL — Flyway checksum stability is critical
*.sql text eol=lf

# Docs: LF
*.md   text eol=lf
*.txt  text eol=lf
LICENSE text eol=lf

# Binary — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.jar  binary
*.war  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.tgz  binary
*.woff binary
*.woff2 binary
*.eot  binary
*.ttf  binary
*.otf  binary

# Large lockfiles: treat as binary to avoid diff noise / accidental CRLF
package-lock.json binary
pnpm-lock.yaml    binary
