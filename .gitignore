HELP.md
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

.vscode/

# Environment variables (contains secrets — never commit)
.env

# Logs — application log files anywhere in the tree
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Frontend local Node.js install (frontend-maven-plugin)
frontend/node/

# Backend static resources (generated from frontend build, copied by maven-resources-plugin)
backend/src/main/resources/static/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
# infra/ — runtime infrastructure directory.
# Keep directory placeholders, ignore runtime contents.
# ============================================================

# PostgreSQL / Redis runtime data (large, host-specific)
infra/data/postgres/*
infra/data/redis/*
!infra/data/**/.gitkeep

# Application log files
infra/logs/*
!infra/logs/.gitkeep

# TLS material — secrets, never committed (matches AGENTS.md rule)
infra/ssl/*
!infra/ssl/.gitkeep

# Externalized config overrides — may contain prod secrets.
# infra/config/ stays committable for non-secret templates; if you drop
# secrets here, gitignore them explicitly by filename.
infra/config/application-prod.yaml
infra/config/application-*.yaml
!infra/config/.gitkeep
